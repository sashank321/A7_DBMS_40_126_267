# KnowledgeSphere AI - Environment Configuration Example

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_local_database_password
POSTGRES_DB=knowledgesphere_db

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@knowledgesphere.ai
PGADMIN_DEFAULT_PASSWORD=replace_with_your_pgadmin_password

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=knowledgesphere_nosql

# Redis
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
STORAGE_DIR=storage/documents

# Embeddings & AI Configuration
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
SIMILARITY_THRESHOLD=0.15
RAG_PROVIDER=auto
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3

# Optional External Cloud LLM APIs (leave blank to use built-in local deterministic extraction)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional demo identities; leave empty to disable demo account discovery.
DEMO_ACCOUNT_EMAILS=[]

# Optional provider configuration
DETERMINISTIC_EMBEDDING_DIM=128
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# Telegram 2FA Delivery (100% Free - Get token from @BotFather, chat_id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
